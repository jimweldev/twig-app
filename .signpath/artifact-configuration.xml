<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for TWIG releases. Paste this into the
  project's artifact configuration on signpath.io. The GitHub artifact is a
  zip holding the NSIS setup .exe and the .msi from .github/workflows/release.yml.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*-setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <msi-file-set>
      <include path="*.msi" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </msi-file-set>
  </zip-file>
</artifact-configuration>
