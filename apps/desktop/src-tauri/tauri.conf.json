{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TWIG",
  "version": "0.1.1",
  "identifier": "com.twig.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TWIG",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "TWIG",
        "url": "splashscreen.html",
        "width": 520,
        "height": 340,
        "center": true,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jimwel Dizon",
    "copyright": "Copyright (c) 2026 Jimwel Dizon. MIT License.",
    "shortDescription": "Teacher’s Work Integration Gateway",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCNjQ5NEIwRTJBQjk2M0MKUldROGxxdmlzSlJraThCS3dEeVJ5eml4ajl5WXpyVkZOS3RZMVlNTTRTYUJIZXovcXBNRFk5elgK",
      "endpoints": [
        "https://github.com/jimweldev/twig-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
